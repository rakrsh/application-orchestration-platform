{
  "name": "aop-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npx ng serve --host 0.0.0.0 --port 4200",
    "build": "npx ng build --configuration production",
    "lint": "prettier --check \"src/**/*.{ts,html,css,scss,js}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,js}\""
  },
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "rxjs": "^7.8.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular/cli": "^16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "typescript": "~5.1.0",
    "prettier": "^3.9.0"
  }
}
